# 🔑 Variables de Entorno - DevMark
# =============================================================================
# Copia este archivo a .env.local y completa los valores
# Las variables con NEXT_PUBLIC_ son accesibles en el cliente
# =============================================================================

# ==========================================
# 🗄️ SUPABASE (Base de Datos) - OBLIGATORIO
# ==========================================
# DEVMARK usa el MISMO proyecto Supabase de jaimetr.dev (decisión: unificar
# ambas bases). Estos 4 valores deben apuntar al MISMO proyecto/keys que
# NEXT_PUBLIC_PROJECTS_SUPABASE_URL/KEY de abajo.
# Obtener en: https://supabase.com/dashboard/project/_/settings/api
# Formato: https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here

# Anon/Public Key de Supabase
# Esta es segura para usar en el cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==========================================
# 🗂️ SUPABASE COMPARTIDO (jaimetr.dev) - tabla "projects"
# Mismo proyecto que el bloque de arriba — mismos valores de URL/key.
# Queda como variable aparte porque el código del portafolio (lectura de
# "projects") usa este nombre; no hace falta duplicar el proyecto en sí.
# ==========================================
NEXT_PUBLIC_PROJECTS_SUPABASE_URL=your_shared_projects_supabase_url_here
NEXT_PUBLIC_PROJECTS_SUPABASE_KEY=your_shared_projects_supabase_key_here

# ==========================================
# 📧 SMTP (Envío de correos) - OBLIGATORIO
# ==========================================
# Configuración del servidor SMTP para formularios de contacto
# Puedes usar Hostinger, Gmail, SendGrid, etc.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_EMAIL=contacto@tudominio.com
SMTP_PASSWORD=tu_password_smtp

# ==========================================
# 🚀 GROQ (Chat/LLM principal) - OBLIGATORIO
# ==========================================
# API Key para usar Groq (llama-3.3-70b-versatile) en el asistente, cotizador y SEO
# Obtener en: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Modelo de Groq a usar (opcional, por defecto llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# 🤖 GOOGLE GENAI (Gemini - imágenes/multimodal) - OPCIONAL
# ==========================================
# API Key para usar Google Generative AI solo para generación/procesado de imágenes
# Obtener en: https://aistudio.google.com/app/apikey
# GOOGLE_GENAI_API_KEY=your_google_ai_api_key_here

# ==========================================
# 🤖 OPENAI (Chatbot alternativo) - OPCIONAL
# ==========================================
# API Key de OpenAI (solo como respaldo si Groq falla)
# Obtener en: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key

# ==========================================
# 💳 STRIPE (Pagos) - OPCIONAL
# ==========================================
# Keys de Stripe para procesar pagos
# Obtener en: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ==========================================
# 🌐 URL DEL SITIO - OBLIGATORIO
# ==========================================
# URL base del sitio (en producción usa tu dominio real)
NEXT_PUBLIC_URL=http://localhost:9002

# ==========================================
# 📅 CAL.COM - OPCIONAL
# ==========================================
# Si quieres abrir un enlace directo de agendamiento cuando el embed no se
# inicializa, define la URL real de tu calendario. Si no se configura, usa la
# landing principal de Cal.com como fallback.
# NEXT_PUBLIC_CAL_LINK=https://app.cal.com/tu-usuario/30min

# ==========================================
# 📱 WHATSAPP - OPCIONAL
# ==========================================
# Número usado en los links "Escríbenos por WhatsApp" del sitio y del
# cotizador. Si no se configura, el código usa +51975646074 como respaldo.
# NEXT_PUBLIC_WHATSAPP_NUMBER=+51975646074

# ==========================================
# 🔍 GOOGLE SEARCH CONSOLE - OPCIONAL
# ==========================================
# Código de verificación de propiedad (método "etiqueta HTML").
# En Search Console > Configuración > Verificación de propiedad > etiqueta HTML,
# copia solo el VALOR del atributo content (no la etiqueta <meta> completa).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=abc123xyz

# ==========================================
# 📊 GOOGLE ANALYTICS (GA4) - OPCIONAL
# ==========================================
# ID de medición de tu propiedad GA4 (Admin > Flujos de datos > tu flujo web).
# Formato: G-XXXXXXXXXX
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ==========================================
# 💱 TASAS DE CONVERSIÓN DE MONEDA - OPCIONAL
# ==========================================
# Tasas de cambio de PEN (Soles Peruanos) a otras monedas
# Si no se configuran, el sistema usa valores por defecto
NEXT_PUBLIC_PEN_TO_USD_RATE=0.27
NEXT_PUBLIC_PEN_TO_EUR_RATE=0.25
NEXT_PUBLIC_PEN_TO_MXN_RATE=4.6
NEXT_PUBLIC_PEN_TO_COP_RATE=1100
NEXT_PUBLIC_PEN_TO_CLP_RATE=250
NEXT_PUBLIC_PEN_TO_ARS_RATE=220
NEXT_PUBLIC_PEN_TO_VES_RATE=9.5
NEXT_PUBLIC_PEN_TO_BOB_RATE=1.9

# =============================================================================
# 📝 NOTAS IMPORTANTES PARA DEPLOYMENT EN VERCEL:
# =============================================================================
#
# VARIABLES OBLIGATORIAS (sin estas el sitio no funcionará correctamente):
# ✓ NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY (proyecto Supabase de DEVMARK)
# ✓ NEXT_PUBLIC_PROJECTS_SUPABASE_URL, NEXT_PUBLIC_PROJECTS_SUPABASE_KEY (portafolio compartido con jaimetr.dev)
# ✓ SMTP_HOST, SMTP_PORT, SMTP_EMAIL, SMTP_PASSWORD (envío de correos: contacto, cotizador)
# ✓ GROQ_API_KEY (motor real del chat/cotizador/SEO con IA — es el que se usa, no Google GenAI)
# ✓ NEXT_PUBLIC_URL
#
# OPCIONALES (el sitio funciona sin ellas, solo se usan si están presentes):
# · GOOGLE_GENAI_API_KEY, OPENAI_API_KEY (respaldo si Groq falla, no se usan en el flujo normal)
# · STRIPE_SECRET_KEY, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (checkout, si se activa)
# · NEXT_PUBLIC_WHATSAPP_NUMBER (si no se define, usa +51975646074)
#
# CONFIGURACIÓN EN VERCEL:
# 1. Sube tu código a GitHub
# 2. Conecta el repositorio en Vercel
# 3. Ve a Settings > Environment Variables
# 4. Agrega TODAS las variables obligatorias
# 5. Para NEXT_PUBLIC_URL usa: https://tudominio.com (o tu URL de Vercel)
# 6. Deploy automático al hacer push a main/master
#
# =============================================================================
